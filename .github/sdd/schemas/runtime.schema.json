{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdd:runtime:1",
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "texts": { "type": "array", "items": { "$ref": "#/$defs/text" }, "uniqueItems": true },
    "phase": { "enum": ["ideation", "requirements", "external-design", "internal-design", "task-planning", "development"] },
    "role": { "enum": ["orchestrator", "ideation", "requirements", "external-design", "internal-design", "task-planner", "implementer", "reviewer"] },
    "revision": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "revisions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/revision" } },
    "human": {
      "type": "object", "additionalProperties": false,
      "required": ["actor", "answer", "source", "timestamp"],
      "properties": { "actor": { "$ref": "#/$defs/text" }, "answer": { "$ref": "#/$defs/text" }, "source": { "$ref": "#/$defs/text" }, "timestamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" }, "recordedBy": { "$ref": "#/$defs/text" } }
    },
    "git": {
      "type": "object", "additionalProperties": false, "required": ["defaultBranch", "branch", "baseCommit"],
      "properties": { "defaultBranch": { "type": ["string", "null"] }, "branch": { "type": ["string", "null"] }, "baseCommit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" } }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "operation", "role", "changeId", "branch", "expectedRevisions", "payload"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "enum": ["change.register", "scratchpad.read", "revision.read", "workflow.status", "scratchpad.update", "question.open", "question.record_answer", "decision.record", "approval.request", "approval.record", "permission.record", "workflow.transition", "traceability.validate", "document.update", "verification.run", "verification.record", "git.inspect", "integration.record", "recover", "doctor"] },
        "role": { "$ref": "#/$defs/role" }, "changeId": { "type": "string", "pattern": "^CHG-[0-9]{4,}$" },
        "branch": { "type": ["string", "null"] }, "expectedRevisions": { "$ref": "#/$defs/revisions" }, "payload": { "type": "object" }, "operationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" }
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "options", "recommendation", "impact", "duePhase", "status", "answer", "reflectedIn"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" }, "options": { "$ref": "#/$defs/texts" }, "recommendation": { "type": "string" }, "impact": { "$ref": "#/$defs/texts" }, "duePhase": { "$ref": "#/$defs/phase" }, "status": { "enum": ["open", "answered", "resolved"] }, "answer": { "anyOf": [{ "$ref": "#/$defs/human" }, { "type": "null" }] }, "reflectedIn": { "$ref": "#/$defs/texts" } }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["id", "text", "rationale", "questionIds", "references"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" }, "rationale": { "$ref": "#/$defs/text" }, "questionIds": { "$ref": "#/$defs/texts" }, "references": { "$ref": "#/$defs/texts" } }
    },
    "manifest": {
      "type": "object", "additionalProperties": false, "required": ["roots", "files", "revision", "inputs"],
      "properties": { "roots": { "$ref": "#/$defs/texts" }, "files": { "$ref": "#/$defs/revisions" }, "revision": { "$ref": "#/$defs/revision" }, "inputs": { "$ref": "#/$defs/revisions" }, "disposition": { "type": "object", "additionalProperties": false, "required": ["kind", "rationale", "referenceRevision", "human"], "properties": { "kind": { "enum": ["unchanged", "not-applicable"] }, "rationale": { "$ref": "#/$defs/text" }, "referenceRevision": { "$ref": "#/$defs/revision" }, "human": { "$ref": "#/$defs/human" } } } }
    },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["phase", "manifest", "judgment", "human"],
      "properties": { "phase": { "$ref": "#/$defs/phase" }, "manifest": { "$ref": "#/$defs/manifest" }, "judgment": { "enum": ["approved", "rejected"] }, "human": { "$ref": "#/$defs/human" } }
    },
    "permission": {
      "type": "object", "additionalProperties": false, "required": ["operations", "editPaths", "readPaths", "outputPaths", "profiles", "allowDelete", "human"],
      "properties": { "operations": { "$ref": "#/$defs/texts" }, "editPaths": { "$ref": "#/$defs/texts" }, "readPaths": { "$ref": "#/$defs/texts" }, "outputPaths": { "$ref": "#/$defs/texts" }, "profiles": { "$ref": "#/$defs/texts" }, "allowDelete": { "type": "boolean" }, "human": { "$ref": "#/$defs/human" }, "phase": { "$ref": "#/$defs/phase" }, "roles": { "type": "array", "items": { "$ref": "#/$defs/role" }, "uniqueItems": true } }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "changeId", "kind", "purpose", "scope", "git", "phase", "status", "actors", "questions", "decisions", "approvals", "permissions", "phaseManifests", "handoff", "integration"],
      "properties": {
        "schemaVersion": { "const": 1 }, "changeId": { "type": "string", "pattern": "^CHG-[0-9]{4,}$" }, "kind": { "enum": ["new", "enhancement", "fix"] }, "purpose": { "$ref": "#/$defs/text" },
        "scope": { "type": "object", "additionalProperties": false, "required": ["in", "out"], "properties": { "in": { "$ref": "#/$defs/texts" }, "out": { "$ref": "#/$defs/texts" } } },
        "git": { "$ref": "#/$defs/git" }, "phase": { "$ref": "#/$defs/phase" }, "status": { "enum": ["draft", "active", "blocked", "awaiting-approval", "approved", "completed", "paused"] }, "resumeStatus": { "enum": ["draft", "active", "blocked", "awaiting-approval", "approved"] },
        "actors": { "type": "object", "additionalProperties": false, "required": ["customer", "technicalLead"], "properties": { "customer": { "$ref": "#/$defs/text" }, "technicalLead": { "$ref": "#/$defs/text" } } },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }, "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
        "approvals": { "type": "array", "items": { "$ref": "#/$defs/approval" } }, "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" } },
        "phaseManifests": { "type": "object", "propertyNames": { "$ref": "#/$defs/phase" }, "additionalProperties": { "$ref": "#/$defs/manifest" } },
        "handoff": { "type": "object", "additionalProperties": false, "required": ["lastOperation", "nextAction", "reason"], "properties": { "lastOperation": { "type": ["string", "null"] }, "nextAction": { "type": "string" }, "reason": { "type": "string" } } },
        "integration": { "type": "object", "additionalProperties": false, "required": ["developmentApproved", "merge", "production"], "properties": { "developmentApproved": { "type": "boolean" }, "merge": { "type": ["object", "null"] }, "production": { "type": ["object", "null"] } } }
      }
    },
    "tasks": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "tasks"],
      "properties": { "schemaVersion": { "const": 1 }, "tasks": { "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "type", "requirementIds", "designIds", "acceptanceIds", "dependsOn", "inputs", "assignee", "editPaths", "verification", "completionCriteria", "status", "evidence", "review"],
        "properties": { "id": { "type": "string", "pattern": "^TASK-[0-9]{4,}$" }, "title": { "$ref": "#/$defs/text" }, "type": { "enum": ["behavior", "documentation", "setup"] }, "requirementIds": { "$ref": "#/$defs/texts" }, "designIds": { "$ref": "#/$defs/texts" }, "acceptanceIds": { "$ref": "#/$defs/texts" }, "dependsOn": { "$ref": "#/$defs/texts" }, "inputs": { "$ref": "#/$defs/revisions" }, "assignee": { "$ref": "#/$defs/role" }, "editPaths": { "$ref": "#/$defs/texts" }, "verification": { "type": "object", "additionalProperties": false, "required": ["method", "environment"], "properties": { "method": { "$ref": "#/$defs/text" }, "environment": { "$ref": "#/$defs/text" }, "profile": { "$ref": "#/$defs/text" }, "reviewer": { "$ref": "#/$defs/text" }, "procedure": { "$ref": "#/$defs/texts" } } }, "completionCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "status": { "enum": ["pending", "active", "blocked", "verified", "obsolete"] }, "evidence": { "$ref": "#/$defs/texts" }, "review": { "$ref": "#/$defs/texts" } }
      } } }
    },
    "traceability": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "links"],
      "properties": { "schemaVersion": { "const": 1 }, "links": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["requirementId", "designIds", "acceptanceIds", "taskIds", "testRefs", "evidenceRefs"], "properties": { "requirementId": { "$ref": "#/$defs/text" }, "designIds": { "$ref": "#/$defs/texts" }, "acceptanceIds": { "$ref": "#/$defs/texts" }, "taskIds": { "$ref": "#/$defs/texts" }, "testRefs": { "$ref": "#/$defs/texts" }, "evidenceRefs": { "$ref": "#/$defs/texts" } } } } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "id", "mode", "taskIds", "inputRevisions", "environment", "timestamp", "method", "status", "result", "nextAction"],
      "properties": { "schemaVersion": { "const": 1 }, "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" }, "mode": { "enum": ["automatic", "manual", "review"] }, "taskIds": { "$ref": "#/$defs/texts" }, "inputRevisions": { "$ref": "#/$defs/revisions" }, "environment": { "$ref": "#/$defs/text" }, "timestamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" }, "method": { "$ref": "#/$defs/text" }, "status": { "enum": ["passed", "failed", "not-run", "unavailable", "out-of-scope"] }, "result": { "type": "string" }, "nextAction": { "type": "string" }, "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 }, "exitCode": { "type": ["integer", "null"] }, "human": { "$ref": "#/$defs/human" }, "independent": { "type": "boolean" }, "reviewer": { "$ref": "#/$defs/text" }, "tddStage": { "enum": ["red", "green", "refactor", "not-applicable"] }, "failureKind": { "enum": ["behavior", "environment", "syntax", "unknown"] } },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "automatic" } } }, "then": { "required": ["command", "exitCode"] } },
        { "if": { "properties": { "mode": { "enum": ["manual", "review"] } } }, "then": { "required": ["human"] } },
        { "if": { "properties": { "mode": { "const": "review" } } }, "then": { "required": ["independent", "reviewer"] } }
      ]
    }
  }
}