{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdd:operations:1",
  "$defs": {
    "empty": { "type": "object", "additionalProperties": false },
    "doctor": { "$ref": "#/$defs/empty" },
    "git.inspect": { "$ref": "#/$defs/empty" },
    "change.register": {
      "type": "object", "additionalProperties": false, "required": ["kind", "purpose", "scope", "actors", "git"],
      "properties": {
        "kind": { "$ref": "urn:sdd:runtime:1#/$defs/state/properties/kind" },
        "purpose": { "$ref": "urn:sdd:runtime:1#/$defs/text" },
        "scope": { "$ref": "urn:sdd:runtime:1#/$defs/state/properties/scope" },
        "actors": { "$ref": "urn:sdd:runtime:1#/$defs/state/properties/actors" },
        "git": { "$ref": "urn:sdd:runtime:1#/$defs/git" }
      }
    },
    "workflow.status": { "type": "object", "additionalProperties": false, "properties": { "recordLimit": { "type": "integer", "minimum": 0, "maximum": 50 } } },
    "revision.read": { "type": "object", "additionalProperties": false, "required": ["paths"], "properties": { "paths": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "urn:sdd:runtime:1#/$defs/text" } } } },
    "scratchpad.read": { "type": "object", "additionalProperties": false, "properties": { "path": { "$ref": "urn:sdd:runtime:1#/$defs/text" } } },
    "document.update": {
      "type": "object", "additionalProperties": false, "required": ["updates"],
      "properties": {
        "updates": { "type": "array", "minItems": 1, "items": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["path", "content"], "properties": { "path": { "$ref": "urn:sdd:runtime:1#/$defs/text" }, "content": { "type": ["string", "null"] } } },
          { "type": "object", "additionalProperties": false, "required": ["path", "edits"], "properties": { "path": { "$ref": "urn:sdd:runtime:1#/$defs/text" }, "edits": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["oldText", "newText"], "properties": { "oldText": { "$ref": "urn:sdd:runtime:1#/$defs/text" }, "newText": { "type": "string" } } } } } }
        ] } }
      }
    },
    "scratchpad.update": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "updates": { "$ref": "#/$defs/document.update/properties/updates" },
        "handoff": { "type": "object", "additionalProperties": false, "required": ["nextAction", "reason"], "properties": { "nextAction": { "type": "string" }, "reason": { "type": "string" } } }
      },
      "anyOf": [{ "required": ["updates"] }, { "required": ["handoff"] }]
    },
    "question.open": {
      "type": "object", "additionalProperties": false, "required": ["text", "options", "recommendation", "impact", "duePhase"],
      "properties": { "text": { "$ref": "urn:sdd:runtime:1#/$defs/text" }, "options": { "$ref": "urn:sdd:runtime:1#/$defs/texts" }, "recommendation": { "type": "string" }, "impact": { "$ref": "urn:sdd:runtime:1#/$defs/texts" }, "duePhase": { "$ref": "urn:sdd:runtime:1#/$defs/phase" } }
    },
    "question.record_answer": {
      "type": "object", "additionalProperties": false, "required": ["questionId", "human"],
      "properties": { "questionId": { "$ref": "urn:sdd:runtime:1#/$defs/text" }, "human": { "$ref": "urn:sdd:runtime:1#/$defs/human" }, "reflectedIn": { "$ref": "urn:sdd:runtime:1#/$defs/texts" } }
    },
    "decision.record": {
      "type": "object", "additionalProperties": false, "required": ["text", "rationale", "questionIds", "references"],
      "properties": { "text": { "$ref": "urn:sdd:runtime:1#/$defs/text" }, "rationale": { "$ref": "urn:sdd:runtime:1#/$defs/text" }, "questionIds": { "$ref": "urn:sdd:runtime:1#/$defs/texts" }, "references": { "$ref": "urn:sdd:runtime:1#/$defs/texts" } }
    },
    "permission.record": { "type": "object", "additionalProperties": false, "required": ["permission"], "properties": { "permission": { "$ref": "urn:sdd:runtime:1#/$defs/permission" } } },
    "approval.request": {
      "type": "object", "additionalProperties": false, "required": ["roots"],
      "properties": { "roots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:sdd:runtime:1#/$defs/text" } }, "disposition": { "$ref": "urn:sdd:runtime:1#/$defs/manifest/properties/disposition" } }
    },
    "approval.record": {
      "type": "object", "additionalProperties": false, "required": ["phase", "revision", "judgment", "human"],
      "properties": { "phase": { "$ref": "urn:sdd:runtime:1#/$defs/phase" }, "revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "judgment": { "enum": ["approved", "rejected"] }, "human": { "$ref": "urn:sdd:runtime:1#/$defs/human" } }
    },
    "workflow.transition": {
      "type": "object", "additionalProperties": false, "required": ["action"],
      "properties": { "action": { "enum": ["activate", "pause", "resume", "return", "advance"] }, "nextPhase": { "$ref": "urn:sdd:runtime:1#/$defs/phase" }, "human": { "$ref": "urn:sdd:runtime:1#/$defs/human" } },
      "allOf": [{ "if": { "properties": { "action": { "enum": ["pause", "resume", "return"] } } }, "then": { "required": ["human"] } }, { "if": { "properties": { "action": { "const": "return" } } }, "then": { "required": ["nextPhase"] } }]
    },
    "traceability.validate": { "type": "object", "additionalProperties": false, "properties": { "specRoots": { "type": "array", "minItems": 1, "items": { "$ref": "urn:sdd:runtime:1#/$defs/text" } } } },
    "verification.record": { "type": "object", "additionalProperties": false, "required": ["evidence"], "properties": { "evidence": { "$ref": "urn:sdd:runtime:1#/$defs/evidence" } } },
    "verification.run": {
      "type": "object", "additionalProperties": false, "required": ["id", "profile", "taskIds", "inputRevisions"],
      "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" }, "profile": { "$ref": "urn:sdd:runtime:1#/$defs/text" }, "taskIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:sdd:runtime:1#/$defs/text" } }, "inputRevisions": { "$ref": "urn:sdd:runtime:1#/$defs/revisions" }, "method": { "$ref": "urn:sdd:runtime:1#/$defs/text" }, "tddStage": { "$ref": "urn:sdd:runtime:1#/$defs/evidence/properties/tddStage" } }
    },
    "integration.record": {
      "type": "object", "additionalProperties": false, "required": ["branch", "commit", "human"],
      "properties": { "branch": { "$ref": "urn:sdd:runtime:1#/$defs/text" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }, "human": { "$ref": "urn:sdd:runtime:1#/$defs/human" } }
    },
    "recover": {
      "type": "object", "additionalProperties": false,
      "properties": { "apply": { "type": "boolean" }, "human": { "$ref": "urn:sdd:runtime:1#/$defs/human" } },
      "allOf": [{ "if": { "required": ["apply"], "properties": { "apply": { "const": true } } }, "then": { "required": ["human"] } }]
    }
  }
}