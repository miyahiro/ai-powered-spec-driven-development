{
  "schemaVersion": 1,
  "mode": "read-only",
  "harness": "Local",
  "hostChecks": { "localHooks": false, "failureDenies": false },
  "readRoots": ["docs", "README.md", ".github/skills", ".github/agents", ".github/copilot-instructions.md", ".github/sdd/README.md"],
  "tools": {
    "read_file": { "kind": "read", "pathKeys": ["filePath"] },
    "file_search": { "kind": "read", "pathKeys": ["query"] },
    "grep_search": { "kind": "read", "pathKeys": ["includePattern"] },
    "semantic_search": { "kind": "read", "pathKeys": [], "workspaceScopeVerified": false },
    "run_in_terminal": { "kind": "execute" },
    "vscode_askQuestions": { "kind": "question" },
    "runSubagent": { "kind": "agent" }
  },
  "verificationProfiles": {}
}